# ------------------------------------------------------------------------------------
#                               PORT CONFIGURATION
# ------------------------------------------------------------------------------------
# - Map container ports to the host machine. Use for DEVELOPMENT environment only.
# - On PRODUCTION environment, only the NGINX port will be exposed to the host machine with
#   external port = 80 (This value is set as a constant in docker-compose.yml and
#   cannot be modified by environment variables).
# - Change these values only if you encounter a port conflict on your local machine.
# - If left empty or commented out (#), the default container ports will be used.
# ------------------------------------------------------------------------------------

# NGINX - proxy. Default: 80
#NGINX_PORT_EXTERNAL=

# Backend API. Default: 8000
#BACKEND_PORT_EXTERNAL=

# MySQL. Default: 3306
#MYSQL_PORT_EXTERNAL=

# Redis. Default: 6379
#REDIS_PORT_EXTERNAL=

# Redis Insight(Redis Web UI). Default: 5540
#REDIS_INSIGHT_PORT_EXTERNAL=

# MinIO (S3 compatible storage)
# API port. Default: 9000
#MINIO_API_PORT_EXTERNAL=
# Web UI port. Default: 9001
#MINIO_CONSOLE_PORT_EXTERNAL=



# MailHog (SMTP testing)
# SMTP port. Default: 1025
#MAIL_HOG_SERVER_PORT_EXTERNAL=
# Web UI port. Default: 8025
#MAIL_HOG_CONSOLE_PORT_EXTERNAL=

# ------------------------------------------------------------------------------------
#                               ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------------
# - Note: In the PRODUCTION environment, please change any value whose default value
#   is 'changethis', otherwise the server will raise a RuntimeError.
# ------------------------------------------------------------------------------------
# 'dev'(for DEVELOPMENT) or 'prod'(for PRODUCTION)
ENVIRONMENT=dev


JWT_SECRET_KEY=changethis
JWT_ACCESS_TOKEN_EXPIRES=180
JWT_REFRESH_TOKEN_EXPIRES=604800

# The following default values are for DEVELOPMENT. A fake SMTP server is used for email service.
# For PRODUCTION, please change.
SMTP_SERVER=mailhog
SMTP_PORT=1025
SMTP_USER=fakemail@fakemail.com
SMTP_PASSWORD=changethis
SMTP_SEND_MAIL_FROM=fakemail@fakemail.com


REDIS_USER=redis_user
REDIS_PASSWORD=changethis


MYSQL_DATABASE=doc_hub
MYSQL_ROOT_PASSWORD=changethis
MYSQL_USER=db_user
MYSQL_PASSWORD=changethis


S3_ACCESS_KEY=admin
S3_SECRET_KEY=changethis